{"cards":[{"emoji":"😋","en":"I am hungry","zh":"我肚餓"},{"emoji":"🍽️","en":"I want to eat","zh":"我要食飯"},{"emoji":"🍚","en":"More rice, please","zh":"唔該加飯"},{"emoji":"😋","en":"Yummy!","zh":"好好味"},{"emoji":"😊","en":"I am full","zh":"我飽喇"},{"emoji":"🙅","en":"I do not want it","zh":"我唔食"}],"description":{"en":"Learn foods and how to say you are hungry or what you like.","yue":"認識食物，學識表達肚餓、鍾意食咩。"},"id":"food","story":{"steps":[{"emoji":"🧼","en":"Wash your hands before eating.","zh":"食飯前洗手。"},{"emoji":"🪑","en":"Sit down and stay at the table.","zh":"坐低，唔好周圍走。"},{"emoji":"🍽️","en":"Take small bites and chew slowly.","zh":"細細啖食，慢慢咬。"},{"emoji":"🙏","en":"Say thank you when you finish.","zh":"食完講聲唔該。"},{"emoji":"😊","en":"Wipe your mouth and clear your bowl.","zh":"抹嘴，收好碗。"}],"title":{"en":"Mealtime manners","yue":"食飯禮儀"}},"title":{"en":"Food","yue":"食物篇"},"version":1,"words":[{"emoji":"🍎","en":"apple","zh":"蘋果"},{"emoji":"🍌","en":"banana","zh":"香蕉"},{"emoji":"🍚","en":"rice","zh":"飯"},{"emoji":"🍜","en":"noodles","zh":"麵"},{"emoji":"🥛","en":"milk","zh":"牛奶"},{"emoji":"🍞","en":"bread","zh":"麵包"},{"emoji":"🥚","en":"egg","zh":"雞蛋"},{"emoji":"💧","en":"water","zh":"水"}]}
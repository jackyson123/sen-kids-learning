{"cards":[{"emoji":"🥵","en":"It is hot today","zh":"今日好熱"},{"emoji":"🌧️","en":"It is raining, take an umbrella","zh":"落雨帶遮"},{"emoji":"💨","en":"It is very windy","zh":"好大風"},{"emoji":"🧥","en":"Wear more clothes","zh":"著多件衫"},{"emoji":"🌈","en":"Look, a rainbow!","zh":"睇彩虹"},{"emoji":"🌩️","en":"I hear thunder","zh":"聽到雷聲"}],"description":{"en":"Learn weather words and what to wear each day.","yue":"認識天氣，學識每日著咩衫。"},"id":"weather","story":{"steps":[{"emoji":"🌤️","en":"Look out of the window. What is the weather?","zh":"望出窗，今日咩天氣？"},{"emoji":"☀️","en":"Sunny: wear a hat and drink water.","zh":"晴天：戴帽，飲多啲水。"},{"emoji":"🌧️","en":"Rainy: take an umbrella and wear boots.","zh":"落雨：帶遮，著雨靴。"},{"emoji":"🥶","en":"Cold: wear a coat and scarf.","zh":"凍：著外套同頸巾。"},{"emoji":"👕","en":"Now you choose today's clothes!","zh":"宜家你揀今日著咩衫！"}],"title":{"en":"What to wear","yue":"天氣點著衫"}},"title":{"en":"Weather","yue":"天氣篇"},"version":1,"words":[{"emoji":"☀️","en":"sun","zh":"太陽"},{"emoji":"☁️","en":"cloud","zh":"雲"},{"emoji":"🌧️","en":"rain","zh":"雨"},{"emoji":"💨","en":"wind","zh":"風"},{"emoji":"❄️","en":"snow","zh":"雪"},{"emoji":"🌩️","en":"thunder","zh":"雷"},{"emoji":"🌈","en":"rainbow","zh":"彩虹"},{"emoji":"🌤️","en":"sunny day","zh":"晴天"}]}
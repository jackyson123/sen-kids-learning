{"cards":[{"emoji":"🚌","en":"I want to take the bus","zh":"我要搭巴士"},{"emoji":"✋","en":"Wait a moment","zh":"等一等"},{"emoji":"🚏","en":"Get off","zh":"落車"},{"emoji":"🙏","en":"Thank you / excuse me","zh":"唔該"},{"emoji":"🗺️","en":"Where are we going?","zh":"去邊度"},{"emoji":"😨","en":"I am scared","zh":"我怕"}],"description":{"en":"Learn vehicles and what to say and do when travelling.","yue":"認識交通工具，學識搭車時講咩、做咩。"},"id":"transport","story":{"steps":[{"emoji":"🧍","en":"Queue for the bus. Do not push.","zh":"排隊等巴士，唔好推人。"},{"emoji":"💳","en":"Tap your card and say thank you.","zh":"上車拍卡，講聲唔該。"},{"emoji":"💺","en":"Find a seat and sit down.","zh":"搵位坐低，扣好安全帶。"},{"emoji":"✋","en":"Stay seated until the bus stops.","zh":"車未停定，唔好起身。"},{"emoji":"🔔","en":"Press the bell and say bye to the driver.","zh":"撳鐘落車，同司機講拜拜。"}],"title":{"en":"Bus rules","yue":"搭巴士守則"}},"title":{"en":"Transport","yue":"交通篇"},"version":1,"words":[{"emoji":"🚌","en":"bus","zh":"巴士"},{"emoji":"🚕","en":"taxi","zh":"的士"},{"emoji":"🚇","en":"MTR / metro","zh":"地鐵"},{"emoji":"🚆","en":"train","zh":"火車"},{"emoji":"⛴️","en":"ferry","zh":"渡輪"},{"emoji":"🚲","en":"bicycle","zh":"單車"},{"emoji":"✈️","en":"airplane","zh":"飛機"},{"emoji":"🚢","en":"boat","zh":"船"}]}